# Clé API Mistral (obligatoire) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=api-key

# Modèle Mistral pour l'analyse (défaut: ministral-8b-latest, économique).
# Évitez mistral-large/medium qui coûtent ~20x plus cher.
MISTRAL_MODEL=ministral-8b-latest

# Intervalle de vérification des prix en secondes (défaut: 60)
CHECK_INTERVAL=60

# Intervalle d'analyse IA en secondes (défaut: 900)
ANALYSIS_INTERVAL=900

# Seuil de variation (%) pour déclencher une alerte immédiate (défaut: 2.0)
ALERT_THRESHOLD=2.0
